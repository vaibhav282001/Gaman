<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Discover premium travel stays, cabins, villas, and beach homes around the world with Gaman. Book your next get-away today.">
    <meta name="keywords" content="travel, bookings, hotels, villas, cabins, rentals, vacation stays">
    <title>Gaman - Discover Premium Stays, Cabins, & Experiences</title>
    
    <!-- CSS Stylesheets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts (Outfit & Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/rating.css" rel="stylesheet">
    <link href="/css/neon.css" rel="stylesheet">
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.24.0/mapbox-gl.css" rel="stylesheet">
    
    <!-- Mapbox GL JS -->
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.24.0/mapbox-gl.js"></script>
    
    <!-- Global user context variables -->
    <script>
      window.currentUserId = "<%= locals.currentUser ? currentUser._id : '' %>";
      window.currentUsername = "<%= locals.currentUser ? currentUser.username : '' %>";
      
      // Theme initialization (Forced Light Mode)
      document.documentElement.setAttribute('data-theme', 'light');
    </script>
</head>
<body>
    
    <% if (!locals.hideNavbar) { %>
        <%- include('../includes/navbar') %>
    <% } %>

    <!-- Unified Toast Manager Container -->
    <div class="toasts-manager-container" id="toastManagerContainer"></div>

    <main class="container-fluid px-md-5 mt-4" style="flex: 1;">
        <%- include("../includes/flash.ejs") %>    
        <%- body %>
    </main>

    <%- include('../includes/footer') %>
    
    <!-- Bootstrap and Script Assets -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="/js/script.js"></script>
</body>
</html>