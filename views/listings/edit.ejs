<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-lg-8 offset-lg-2">
    <div class="card p-4 p-md-5 border-0 shadow-sm" style="border-radius: var(--radius-lg); background: var(--background);">
      
      <!-- Edit Header -->
      <div class="text-center mb-5">
        <h2 class="fw-extrabold" style="font-family: var(--font-main); font-weight: 800; letter-spacing: -0.5px;">Edit Stay Details</h2>
        <p class="text-muted">Keep your stay information, descriptions, location, and nightly price updated for guests.</p>
      </div>

      <!-- Update Form -->
      <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation" encType="multipart/form-data">
        
        <!-- Section: Title & Description -->
        <h5 class="fw-bold mb-4 text-dark"><i class="fa-regular fa-file-lines text-danger me-2"></i>Stay Metadata</h5>
        
        <div class="floating-label-block">
          <input type="text" id="title" name="listing[title]" value="<%= listing.title %>" placeholder=" " required>
          <label for="title">Catchy Property Title</label>
          <div class="invalid-feedback">Please enter a headline title for your listing.</div>
        </div>
        
        <div class="floating-label-block">
          <textarea id="description" name="listing[description]" rows="5" placeholder=" " required><%= listing.description %></textarea>
          <label for="description">Detailed Description</label>
          <div class="invalid-feedback">Please provide a description explaining stay details.</div>
        </div>

        <hr class="my-4 border-light">

        <!-- Section: Media Upload & Preview -->
        <h5 class="fw-bold mb-4 text-dark"><i class="fa-regular fa-image text-danger me-2"></i>Cover Media</h5>
        <div class="row align-items-center mb-4 g-4">
          <div class="col-sm-5 text-center">
            <span class="text-muted small d-block mb-2">Original Image Thumbnail</span>
            <div class="border rounded-3 p-2 d-inline-block bg-light">
              <img src="<%= originalImageUrl %>" alt="Listing Image Thumbnail" class="img-fluid rounded" style="max-height: 140px; object-fit: cover; max-width: 200px;" />
            </div>
          </div>
          <div class="col-sm-7">
            <label for="image" class="form-label fw-bold text-dark small">Upload New Cover Photo</label>
            <input type="file" id="image" name="listing[image]" class="form-control" />
            <span class="text-muted small mt-1 d-block">Leave empty if you don't wish to change the cover image.</span>
          </div>
        </div>

        <hr class="my-4 border-light">

        <!-- Section: Location details -->
        <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-location-dot text-danger me-2"></i>Location & Country</h5>
        <div class="row">
          <div class="col-md-6">
            <div class="floating-label-block">
              <input type="text" id="location" name="listing[location]" value="<%= listing.location %>" placeholder=" " required>
              <label for="location">City / State</label>
              <div class="invalid-feedback">Please provide your stay's city location.</div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="floating-label-block">
              <input type="text" id="country" name="listing[country]" value="<%= listing.country %>" placeholder=" " required>
              <label for="country">Country</label>
              <div class="invalid-feedback">Please provide your stay's country.</div>
            </div>
          </div>
        </div>

        <hr class="my-4 border-light">

        <!-- Section: Pricing -->
        <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-indian-rupee-sign text-danger me-2"></i>Nightly Price</h5>
        <div class="floating-label-block">
          <input type="number" id="price" name="listing[price]" value="<%= listing.price %>" placeholder=" " step="0.01" min="1" required>
          <label for="price">Nightly rate (₹ INR)</label>
          <div class="invalid-feedback">Please specify a valid nightly price.</div>
        </div>

        <div class="floating-label-block mt-3">
          <input type="text" id="listingOffer" placeholder=" " autocomplete="off">
          <label for="listingOffer">Special Offer or Discount (optional)</label>
        </div>

        <!-- Submit buttons footer -->
        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
          <a href="/listings/<%= listing._id %>" class="btn btn-outline-dark rounded-pill px-4 fw-bold">Cancel</a>
          <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold hover-lift" id="editFormSubmitBtn">Update Listing</button>
        </div>

      </form>
    </div>
  </div>
</div>