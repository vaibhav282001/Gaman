<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-lg-8 offset-lg-2">
    <div class="neo-box p-4 p-md-5 border-0 shadow-sm" style="border-radius: var(--radius-lg); background: var(--background);">
      
      <!-- Wizard Title Header -->
      <div class="text-center mb-5">
        <h2 class="fw-extrabold" style="font-family: var(--font-main); font-weight: 800; letter-spacing: -0.5px;">List your property on Gaman</h2>
        <p class="text-muted">Follow our simple step-by-step checklist to list your property and begin hosting guests.</p>
      </div>

      <!-- Step Progress Line Indicator -->
      <div class="wizard-progress-bar-container">
        <div class="wizard-progress-line-bg"></div>
        <div class="wizard-progress-line-fill" id="wizardProgressFill"></div>
        <div class="wizard-progress-node active">1</div>
        <div class="wizard-progress-node">2</div>
        <div class="wizard-progress-node">3</div>
        <div class="wizard-progress-node">4</div>
        <div class="wizard-progress-node">5</div>
        <div class="wizard-progress-node">6</div>
      </div>

      <!-- Multi-step Form wrapper -->
      <form action="/listings" method="POST" novalidate class="needs-validation" encType="multipart/form-data">
        
        <!-- STEP 1: BASIC INFORMATION -->
        <div class="wizard-form-step-panel active">
          <h5 class="fw-bold mb-4 text-dark"><i class="fa-regular fa-file-lines text-danger me-2"></i>Step 1: Tell us about your place</h5>
          
          <div class="floating-label-block">
            <input type="text" id="title" class="neo-input" name="listing[title]" placeholder=" " required>
            <label for="title" style="margin-left: 15px; margin-top: 2px;">Catchy Property Title</label>
            <div class="invalid-feedback">Please enter a headline title for your listing.</div>
          </div>
          
          <div class="floating-label-block">
            <textarea id="description" name="listing[description]" rows="5" class="neo-input" placeholder=" " required></textarea>
            <label for="description" style="margin-left: 15px; margin-top: 5px;">Detailed Description</label>
            <div class="invalid-feedback">A description explaining bedroom details, amenities, and surroundings is required.</div>
          </div>
        </div>

        <!-- STEP 2: PHOTOS UPLOAD -->
        <div class="wizard-form-step-panel">
          <h5 class="fw-bold mb-4 text-dark"><i class="fa-regular fa-image text-danger me-2"></i>Step 2: Add high-quality photos</h5>
          <p class="text-muted small mb-3">Upload up to 5 bright photographs to make your property stand out in search grids. The first photo will be your cover.</p>
          
          <div class="mb-4">
            <div class="image-preview-placeholder-box" id="imagePreviewPlaceholder" onclick="document.getElementById('image').click()">
              <i class="fa-solid fa-images display-4 text-secondary mb-2"></i>
              <h6 class="fw-bold mb-1">Click to upload photos (Max 5)</h6>
              <p class="text-muted small mb-0">PNG, JPG, or WEBP up to 5MB each</p>
            </div>
            <input type="file" id="image" name="listing[image]" class="form-control d-none" required multiple accept="image/*">
            <div class="invalid-feedback mt-2">At least one listing photo is required (up to 5 allowed).</div>
          </div>
        </div>

        <!-- STEP 3: LOCATION DETAILS -->
        <div class="wizard-form-step-panel">
          <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-location-dot text-danger me-2"></i>Step 3: Pinpoint location</h5>
          
          <div class="row">
            <div class="col-md-6">
              <div class="floating-label-block">
                <input type="text" id="location" name="listing[location]" class="neo-input" placeholder=" " required>
                <label for="location" style="margin-left: 15px; margin-top: 2px;">City / State</label>
                <div class="invalid-feedback">Please provide your stay's city location.</div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="floating-label-block">
                <input type="text" id="country" name="listing[country]" class="neo-input" placeholder=" " required>
                <label for="country" style="margin-left: 15px; margin-top: 2px;">Country</label>
                <div class="invalid-feedback">Please provide your stay's country.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 4: AMENITIES WIDGET -->
        <div class="wizard-form-step-panel">
          <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-wand-magic-sparkles text-danger me-2"></i>Step 4: Select amenities</h5>
          <p class="text-muted small mb-3">Select the features available for guests staying at your listing.</p>
          
          <div class="amenity-checkbox-grid">
            <div class="amenity-checkbox-card">
              <i class="fa-solid fa-wifi"></i>
              <span>Wifi</span>
              <input type="checkbox" data-amenity="wifi">
            </div>
            <div class="amenity-checkbox-card">
              <i class="fa-solid fa-kitchen-set"></i>
              <span>Kitchen</span>
              <input type="checkbox" data-amenity="kitchen">
            </div>
            <div class="amenity-checkbox-card">
              <i class="fa-solid fa-person-swimming"></i>
              <span>Pool</span>
              <input type="checkbox" data-amenity="pool">
            </div>
            <div class="amenity-checkbox-card">
              <i class="fa-solid fa-snowflake"></i>
              <span>AC</span>
              <input type="checkbox" data-amenity="ac">
            </div>
            <div class="amenity-checkbox-card">
              <i class="fa-solid fa-car"></i>
              <span>Parking</span>
              <input type="checkbox" data-amenity="parking">
            </div>
            <div class="amenity-checkbox-card">
              <i class="fa-solid fa-soap"></i>
              <span>Washer</span>
              <input type="checkbox" data-amenity="washer">
            </div>
            <div class="amenity-checkbox-card">
              <i class="fa-solid fa-briefcase"></i>
              <span>Workspace</span>
              <input type="checkbox" data-amenity="workspace">
            </div>
            <div class="amenity-checkbox-card">
              <i class="fa-solid fa-tv"></i>
              <span>Smart TV</span>
              <input type="checkbox" data-amenity="tv">
            </div>
          </div>
        </div>

        <!-- STEP 5: PRICING -->
        <div class="wizard-form-step-panel">
          <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-indian-rupee-sign text-danger me-2"></i>Step 5: Set nightly pricing</h5>
          <p class="text-muted small mb-3">Determine your pricing scale. You can adjust this fee according to peak seasons later.</p>
          
          <div class="floating-label-block">
            <input type="number" id="price" name="listing[price]" class="neo-input" placeholder=" " step="0.01" min="1" required>
            <label for="price" style="margin-left: 15px; margin-top: 2px;">Nightly rate (₹ INR)</label>
            <div class="invalid-feedback">Please specify a valid nightly price.</div>
          </div>

          <div class="floating-label-block mt-3">
            <input type="text" id="listingOffer" class="neo-input" placeholder=" " autocomplete="off">
            <label for="listingOffer" style="margin-left: 15px; margin-top: 2px;">Special Offer or Discount (optional)</label>
          </div>
        </div>

        <!-- STEP 6: PUBLISH PREVIEW -->
        <div class="wizard-form-step-panel">
          <h5 class="fw-bold mb-4 text-dark"><i class="fa-regular fa-square-check text-danger me-2"></i>Step 6: Review & Publish</h5>
          <p class="text-muted small mb-4">Take a final look at how your property preview card will appear to guests.</p>
          
          <div class="row justify-content-center">
            <div class="col-sm-8 col-md-6 col-lg-5">
              <div class="card shadow border rounded-4 overflow-hidden p-0" style="background: var(--background);">
                <div style="aspect-ratio: 1/1; background: #e0e0e0;" class="d-flex align-items-center justify-content-center text-secondary position-relative">
                  <i class="fa-regular fa-image display-4"></i>
                  <div class="position-absolute top-3 start-3 bg-danger text-white rounded-pill px-2 py-1 fw-bold small">Draft Card</div>
                </div>
                <div class="p-3">
                  <div class="d-flex justify-content-between mb-1">
                    <strong class="text-truncate d-block" id="previewTitleVal" style="max-width: 140px;">My Gaman Stay</strong>
                    <span><i class="fa-solid fa-star text-danger me-1"></i>New</span>
                  </div>
                  <div class="text-muted small mb-1 text-truncate" id="previewDescVal">A beautiful cozy retreat.</div>
                  <div class="text-muted small mb-2" id="previewLocationVal">Malibu, India</div>
                  <div class="text-dark fw-bold" id="previewPriceVal">₹1,500 / night</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Wizard Navigation Controls Footer -->
        <div class="wizard-footer-buttons">
          <button type="button" class="neo-button wizard-back-btn" id="wizardPrevBtn" style="background: transparent !important; box-shadow: none !important;">Back</button>
          <button type="button" class="neo-button wizard-next-btn" id="wizardNextBtn">Next Step</button>
        </div>

      </form>
    </div>
  </div>
</div>